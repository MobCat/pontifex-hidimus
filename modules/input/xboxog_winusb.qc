// Xbox Original Controller (USB) phidimus input module.
// Supports all original Xbox Controllers that all share the same 20 byte USB packet layout.
// The only diffrences is the VIDs and PIDs. see declare_devices for a full suported list.
// A remider that VID is the Vender (Microsoft, Logitech, Mad Catz, etc.)
// And PID is the Product (The duke, Controller S, Thunderpad, etc.)

// This module is intended to be used with passive xbox controller to usb adaptors
// Any other adaptor that tries to convert the inputs to something else, you will need a module for that
// adaptor and its weirdness. This module is meant to be used to read the controllers directly without an active converter device.
//
// Windows driver weirdness: Windows 10 and above should automatically bind the controller to
// the WinUSB driver via the standard libwdi autogenerated driver.
// Interface GUID {88BAE032-5A81-49F0-BC3D-A4FF138216D6} should be handled by winusb_input by default.
// If issues persist you may have to do a Install WCID Driver with Zadig (https://zadig.akeo.ie)
// and manually register the interface GUID with the WCID driver.
// This sounds like a mess, but its better then using a 20 year old unsigned driver that windows now hates
// And you have to go out of your way to force windows to let you use it. This way windows just windows on its own
// and we convert that mess to our own mess.

string MODULE_ID      = "xboxog_winusb";
string MODULE_NAME    = "Xbox Original Controller (WinUSB input)";
string MODULE_VERSION = "1.2.0";
string MODULE_AUTHOR  = "MobCat";
string ENGINE_VERSION = "4.3.0";
string DRIVER         = "winusb_input";


void() declare_devices =
// Declared / Known Original xbox controllers with the same 20 byte USB packet layout.
// Note: VID_045E&PID_001C in your device list is the Xbox USB hub, not the Controller.
//                              ┌─> The Real xbox controller. The buttons and thumbsticks
// usb cable -> xbox "usb" hub ─┼─> Memory card / expansion port 1
//                              ├─> Memory card / expansion port 2
//                              └─> Unmapped / undocumented / unused
// Phidimus only binds and hides the real xbox controller, all other devices on this hub,
// and the hub itself will remain unchanged and available by your os.
// For eg. Using the memory cards slots with FATXplorer 3.0 beta should not affect phidimus.
// This also means devices like the xbox communicator will need there own drivers outside of phidimus. We only do controls here.
{
//  add_device(VID, PID, "Product name");
    add_device(0x045E, 0x0202, "Xbox Original Controller (The Duke)");
    add_device(0x045E, 0x0285, "Xbox Original Controller S (Japan)");
    add_device(0x045E, 0x0287, "Xbox Original Controller S");
    add_device(0x045E, 0x0288, "Xbox Original Controller S v2");
    add_device(0x045E, 0x0289, "Xbox Original Controller S (US/EU)");
    add_device(0x044F, 0x0F07, "Thrustmaster Controller (Xbox)");
    add_device(0x046D, 0xCA84, "Logitech Cordless Precision (Xbox)");
    add_device(0x046D, 0xCA88, "Logitech Thunderpad (Xbox)");
};

void() declare_signals =
{
    // Feedback (rumble) Optional, matches the 6-byte output packet format.
    // feedback_len(6) allocates the output buffer used by write_feedback().
    feedback_len(6);
    feedback("RUMBLE_LEFT",  0, 255);  // left  actuator (low-freq / heavy)
    feedback("RUMBLE_RIGHT", 0, 255);  // right actuator (high-freq / light)

    // D-Pad (digital only — the Xbox OG D-Pad is not analog)
    btn("BTN_DPAD_UP");
    btn("BTN_DPAD_DOWN");
    btn("BTN_DPAD_LEFT");
    btn("BTN_DPAD_RIGHT");

    // System buttons
    btn("BTN_START");
    btn("BTN_BACK");
    btn("BTN_L3");   // left  stick click
    btn("BTN_R3");   // right stick click

    // Face buttons are ANALOG-first on the original Xbox — each reports 0-255 of
    // travel/pressure, not a simple on/off. We expose that analog value directly.
    // The DIGITAL press is derived in the config, not here: bind BTN_A to a
    // digital output button and the engine fires it when the analog crosses a
    // per-button "threshold=" (default 128). The same BTN_A can ALSO be bound to
    // an analog output axis at the same time (pressure-sensitive control) — the
    // two don't conflict. Putting the threshold in the config means an ageing
    // controller can be re-tuned without editing this module.
    axis("BTN_A",     0, 255);
    axis("BTN_B",     0, 255);
    axis("BTN_X",     0, 255);
    axis("BTN_Y",     0, 255);
    axis("BTN_BLACK", 0, 255);
    axis("BTN_WHITE", 0, 255);

    // Analog triggers (0=released 255=fully pressed)
    axis("LEFT_TRIGGER",  0, 255);
    axis("RIGHT_TRIGGER", 0, 255);

    // Analog sticks (-32768:32767, 0=centre)
    // Signed 8-bit precision?
    axis("LEFT_STICK_X",  -32768, 32767);
    axis("LEFT_STICK_Y",  -32768, 32767);
    axis("RIGHT_STICK_X", -32768, 32767);
    axis("RIGHT_STICK_Y", -32768, 32767);
};

///////////////////////////////////////////////////////////////////////////////
// parse() Called on every 20-byte USB packet received from the controller.

void(bytes raw) parse =
{
    // Guard: only process valid input packets.
    if (raw[0] != 0x00) { return; }
    if (raw[1] < 0x14)  { return; }   // must be at least 20 bytes

    // Digital buttons from byte 2.
    local int btns = raw[2];
    set_btn("BTN_DPAD_UP",    btns & 0x01);
    set_btn("BTN_DPAD_DOWN",  btns & 0x02);
    set_btn("BTN_DPAD_LEFT",  btns & 0x04);
    set_btn("BTN_DPAD_RIGHT", btns & 0x08);
    set_btn("BTN_START",      btns & 0x10);
    set_btn("BTN_BACK",       btns & 0x20);
    set_btn("BTN_L3",         btns & 0x40);
    set_btn("BTN_R3",         btns & 0x80);

    // Analog face buttons (0-255 pressure). No threshold here — the digital
    // press is derived in the config via a per-button "threshold=" option, so an
    // ageing controller can be re-tuned without touching this module.
    set_axis("BTN_A",     raw[4]);
    set_axis("BTN_B",     raw[5]);
    set_axis("BTN_X",     raw[6]);
    set_axis("BTN_Y",     raw[7]);
    set_axis("BTN_BLACK", raw[8]);
    set_axis("BTN_WHITE", raw[9]);

    // Analog triggers
    set_axis("LEFT_TRIGGER",  raw[10]);
    set_axis("RIGHT_TRIGGER", raw[11]);

    // Sticks. Int16 little-endian, sign-extended from raw 16-bit field.
    local int lx = raw[12] | (raw[13] << 8);
    local int ly = raw[14] | (raw[15] << 8);
    local int rx = raw[16] | (raw[17] << 8);
    local int ry = raw[18] | (raw[19] << 8);

    // Two's-complement sign extension: values > 32767 are negative.
    if (lx > 32767) { lx = lx - 65536; }
    if (ly > 32767) { ly = ly - 65536; }
    if (rx > 32767) { rx = rx - 65536; }
    if (ry > 32767) { ry = ry - 65536; }

    // Negate Y: hardware reports up=-32768, XInput convention is up=+32767.
    if (ly == -32768) { ly = -32767; }
    if (ry == -32768) { ry = -32767; }
    set_axis("LEFT_STICK_X",  lx);
    set_axis("LEFT_STICK_Y",  -ly);
    set_axis("RIGHT_STICK_X", rx);
    set_axis("RIGHT_STICK_Y", -ry);
};

///////////////////////////////////////////////////////////////////////////////
// write_feedback() Send rumble to the controller.
//
// Xbox OG rumble output packet (6 bytes, sent to endpoint 2 OUT). Each actuator
// is a 16-bit LITTLE-ENDIAN value, not a single byte (this is what tripped the
// old code — it treated [2]/[3] as two 8-bit motors). Matches the Linux xpad
// driver: it writes our 0-255 level into the HIGH byte (value<<8), so the low
// bytes stay 0:
//   [0]    = 0x00 (type marker)
//   [1]    = 0x06 (length)
//   [2..3] = left  actuator, 16-bit LE (low-freq / heavy) — level in [3]
//   [4..5] = right actuator, 16-bit LE (high-freq / light) — level in [5]

void() write_feedback =
{
    set_feedback_byte(0, 0x00);
    set_feedback_byte(1, 0x06);
    set_feedback_byte(3, get_feedback("RUMBLE_LEFT"));   // left  actuator (high byte of [2..3])
    set_feedback_byte(5, get_feedback("RUMBLE_RIGHT"));  // right actuator (high byte of [4..5])
    // bytes 2 and 4 (the LE low bytes) remain 0x00 — buffer is zeroed each call
};
